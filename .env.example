# Banco local (SQLite). Para produção, troque para PostgreSQL (veja README).
DATABASE_URL="file:./dev.db"

# Gere com: openssl rand -base64 32
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Chave da OpenAI. Se ficar vazia, o app roda em MODO DEMO (análise heurística, sem IA).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Opcional: qualquer API compatível com OpenAI (ex.: Groq, OpenRouter)
OPENAI_BASE_URL="https://api.openai.com/v1"
